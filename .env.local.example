# Copiar a .env.local (ya está en .gitignore, nunca se commitea) y completar
# con los valores reales del proyecto en https://supabase.com/dashboard.

# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings → API → Project API keys → service_role (secreta — solo se usa en
# scripts/servidor, NUNCA en código que corra en el browser)
SUPABASE_SERVICE_ROLE_KEY=

# https://www.mercadopago.com.ar/developers/panel → tu app → Credenciales de prueba
# Sin esto, el checkout con Mercado Pago activa la matrícula en modo
# simulado (ver docs/SPEC.md) en vez de mandar a un pago real.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Origen público del sitio, usado para las back_urls y el webhook que le
# pasamos a Mercado Pago. En local podés dejarlo vacío (se infiere de la
# request), pero el webhook real necesita una URL pública (ver docs/SPEC.md).
NEXT_PUBLIC_SITE_URL=
