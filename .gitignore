# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# design handoff (external reference material, not part of the app)
/design_handoff_ew_academy/

# internal project docs (spec + roadmap, not published to the repo)
/docs/

# typescript
*.tsbuildinfo
next-env.d.ts
