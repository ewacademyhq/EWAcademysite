# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem

# Claude Code — worktrees/session-local state, not shared project config
# (.claude/launch.json stays tracked, it's the shared dev-server config)
.claude/worktrees/
.claude/scheduled_tasks.lock

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# design handoff (external reference material, not part of the app)
/design_handoff_ew_academy/

# internal project docs (spec + roadmap, not published to the repo)
/docs/

# typescript
*.tsbuildinfo
next-env.d.ts
